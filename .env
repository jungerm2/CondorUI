# =============================================================================
# Condor Web UI — Environment Variables
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
# All values shown here are the defaults.
#
# Usage:
#   source .env
#   python run.py
# =============================================================================

# ---------------------------------------------------------------------------
# Flask / Application
# ---------------------------------------------------------------------------

# Flask secret key — CHANGE THIS in production!
export SECRET_KEY=condor-webui-dev-key

# Database URI (SQLAlchemy format)
export DATABASE_URL=sqlite:///instance/condor_webui.db

# Maximum upload size in bytes (10 GB)
export MAX_CONTENT_LENGTH=10737418240

# ---------------------------------------------------------------------------
# File & Directory Paths
# ---------------------------------------------------------------------------

# Directory for uploaded submit files and input files (relative to project root)
export UPLOAD_DIR=uploads

# Directory for job stdout, stderr, and user logs (relative to project root)
export JOB_LOGS_DIR=condor_job_logs

# Directory for uploaded executables (relative to project root)
export EXECUTABLES_DIR=executables

# ---------------------------------------------------------------------------
# OSDF (Open Science Data Federation) — File Staging
# ---------------------------------------------------------------------------

# OSDF root path for file transfers — uploaded files and containers are stored
# in subdirectories (uploads/, containers/) under this path.
# Defaults to conform with https://chtc.cs.wisc.edu/uw-research-computing/staging-transition
# Leave empty to disable OSDF staging.
export OSDF_ROOT_PATH=/staging/${USER:0:1}/$USER/webui

# Base URI prefix for OSDF-staged files (e.g., "osdf:///" or "gsiftp://...")
export OSDF_BASE_URI=osdf:///chtc

# ---------------------------------------------------------------------------
# HTCondor Query Limits
# ---------------------------------------------------------------------------

# Maximum number of history results to return by default
export MAX_HISTORY_RESULTS=200

# ---------------------------------------------------------------------------
# Development Server
# ---------------------------------------------------------------------------

# Host address for the Flask dev server
export HOST=0.0.0.0

# Port for the Flask dev server
export PORT=5000

# Set to 1 to enable debug mode (auto-reload on code changes)
export FLASK_DEBUG=0

# ---------------------------------------------------------------------------
# Containers
# ---------------------------------------------------------------------------

# Tempdir for apptainer's build
export APPTAINER_TMPDIR=$HOME/.cache/apptainer
mkdir -p $APPTAINER_TMPDIR
